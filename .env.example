# docker compose 环境变量样例（复制为 .env 后按需修改；.env 已被 .gitignore 忽略，禁止入库）

# 宿主机端口：后端 8080 被其他项目占用时改成 8081 等
API_PORT=8080
# 前端访问端口（默认 8088，刻意避开 Vite dev server / Playwright 使用的 5173）
WEB_PORT=8088

# JWT 签名密钥（必填）：至少 32 字节的随机串，留空或使用开发默认值时 docker compose 拒绝启动
# PowerShell: -join ((1..48) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
# Git Bash / Linux: openssl rand -hex 24
JWT_SECRET=

# AI 模块：静态总开关 + 密钥（密钥只经环境变量注入，禁止写入代码或镜像）
# 容器演示默认开启（compose 未显式设置时按 true 注入）；不填密钥也能体验 AI 交互，回复走本地规则并在界面明确标注
# 关闭 AI：改成 false 后 `docker compose up -d api`，或运行时 `pwsh server/scripts/ai-switch.ps1 -Off`
AI_ENABLE=true
AGNES_API_KEY=
