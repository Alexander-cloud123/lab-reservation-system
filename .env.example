# docker compose 环境变量样例（复制为 .env 后按需修改；.env 已被 .gitignore 忽略，禁止入库）

# 宿主机端口：后端 8080 被其他项目占用时改成 8081 等
API_PORT=8080
# 前端访问端口（默认 8088，刻意避开 Vite dev server / Playwright 使用的 5173）
WEB_PORT=8088

# JWT 签名密钥（生产/演示环境务必替换为随机长串）
JWT_SECRET=reservation-system-jwt-secret-2026

# AI 模块：静态总开关 + 密钥（密钥只经环境变量注入，禁止写入代码或镜像）
AI_ENABLE=false
AGNES_API_KEY=
